[
 {
  "page": "https://dev.iugu.com/reference/transferir-valor.md",
  "definition": {
   "openapi": "3.1.0",
   "info": {
    "title": "transferência-de-valores",
    "version": "1.0"
   },
   "servers": [
    {
     "url": "https://api.iugu.com/v1"
    }
   ],
   "components": {
    "securitySchemes": {
     "sec0": {
      "type": "apiKey",
      "in": "query",
      "name": "api_token"
     }
    }
   },
   "security": [
    {
     "sec0": []
    }
   ],
   "paths": {
    "/transfers": {
     "post": {
      "summary": "Transferir Valor entre contas iugu",
      "description": "Transferir valor de uma Conta iugu para outra Conta iugu. <br><br>Este endpoint está configurado para operar exclusivamente em ambiente de produção <b>(live_mode)</b>.",
      "operationId": "transferir-valor",
      "parameters": [
       {
        "name": "Request-Time",
        "in": "header",
        "description": "Timestamp do momento que enviar a requisição de assinatura digital (RSA)",
        "required": true,
        "schema": {
         "type": "string",
         "format": "date-time"
        }
       },
       {
        "name": "Signature",
        "in": "header",
        "description": "Assinatura digital validada",
        "required": true,
        "schema": {
         "type": "string",
         "default": "signature="
        }
       },
       {
        "in": "header",
        "name": "X-Signature-Token-Id",
        "schema": {
         "type": "string"
        },
        "description": "Indica explicitamente qual token/chave deve ser utilizado na assinatura da requisição, informando o ID do token desejado. Se omitido, mantém o comportamento atual."
       }
      ],
      "requestBody": {
       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "properties": {
           "receiver_id": {
            "type": "string",
            "description": "Account ID da conta que irá receber o valor. [Saiba mais](https://support.iugu.com/hc/pt-br/articles/201726767-ID-da-conta-e-tokens-de-API-de-teste-e-de-produ%C3%A7%C3%A3o)"
           },
           "amount_cents": {
            "type": "integer",
            "description": "Valor a transferir em centavos",
            "format": "int32"
           },
           "custom_variables": {
            "type": "array",
            "description": "Variáveis Personalizadas",
            "items": {
             "properties": {
              "name": {
               "type": "string",
               "description": "Nome da Variável"
              },
              "value": {
               "type": "string",
               "description": "Valor da Variável"
              }
             },
             "type": "object"
            }
           },
           "api_token": {
            "type": "string",
            "description": "Chave de API privada"
           }
          }
         }
        }
       }
      },
      "responses": {
       "200": {
        "description": "200",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{\n  \"id\": \"7839481C235A47C088987FE94360E9BD\",\n  \"created_at\": \"2024-04-29T10:16:34-03:00\",\n  \"amount_cents\": 100,\n  \"amount_localized\": \"R$ 1,00\",\n  \"updated_at\": \"2024-04-29T10:16:34-03:00\",\n  \"receiver\": {\n    \"id\": \"0D16C52DD91F413BACFA24FD6868B18A\",\n    \"name\": \"Nome da Conta Destino\"\n  },\n  \"sender\": {\n    \"id\": \"27016E1AD888499A98994E781B6C3762\",\n    \"name\": \"Nome da Conta Pagadora \"\n  },\n  \"custom_variables\": []\n}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {
            "id": {
             "type": "string",
             "example": "7839481C235A47C088987FE94360E9BD"
            },
            "created_at": {
             "type": "string",
             "example": "2024-04-29T10:16:34-03:00"
            },
            "amount_cents": {
             "type": "integer",
             "example": 100,
             "default": 0
            },
            "amount_localized": {
             "type": "string",
             "example": "R$ 1,00"
            },
            "updated_at": {
             "type": "string",
             "example": "2024-04-29T10:16:34-03:00"
            },
            "receiver": {
             "type": "object",
             "properties": {
              "id": {
               "type": "string",
               "example": "0D16C52DD91F413BACFA24FD6868B18A"
              },
              "name": {
               "type": "string",
               "example": "Nome da Conta Destino"
              }
             }
            },
            "sender": {
             "type": "object",
             "properties": {
              "id": {
               "type": "string",
               "example": "27016E1AD888499A98994E781B6C3762"
              },
              "name": {
               "type": "string",
               "example": "Nome da Conta Pagadora "
              }
             }
            },
            "custom_variables": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {}
             }
            }
           }
          }
         }
        }
       },
       "422": {
        "description": "422",
        "content": {
         "application/json": {
          "examples": {
           "Empty params": {
            "value": "{\n  \"message\": {\n    \"receiver_account_id\": [\n      \"não pode ficar em branco\"\n    ],\n    \"amount_cents\": [\n      \"não pode ficar em branco\",\n      \"não é um número\"\n    ]\n  }\n}"
           },
           "Insufficient funds": {
            "value": "{\n  \"message\": {\n    \"amount_cents\": [\n      \"Saldo insuficiente\"\n    ]\n  }\n}"
           },
           "Receiver Not Found": {
            "value": "{\n  \"message\": {\n    \"receiver_account\": [\n      \"não encontrado\"\n    ]\n  }\n}"
           }
          },
          "schema": {
           "oneOf": [
            {
             "title": "Empty params",
             "type": "object",
             "properties": {
              "message": {
               "type": "object",
               "properties": {
                "receiver_account_id": {
                 "type": "array",
                 "items": {
                  "type": "string",
                  "example": "não pode ficar em branco"
                 }
                },
                "amount_cents": {
                 "type": "array",
                 "items": {
                  "type": "string",
                  "example": "não pode ficar em branco"
                 }
                }
               }
              }
             }
            },
            {
             "title": "Insufficient funds",
             "type": "object",
             "properties": {
              "message": {
               "type": "object",
               "properties": {
                "amount_cents": {
                 "type": "array",
                 "items": {
                  "type": "string",
                  "example": "Saldo insuficiente"
                 }
                }
               }
              }
             }
            },
            {
             "title": "Receiver Not Found",
             "type": "object",
             "properties": {
              "message": {
               "type": "object",
               "properties": {
                "receiver_account": {
                 "type": "array",
                 "items": {
                  "type": "string",
                  "example": "não encontrado"
                 }
                }
               }
              }
             }
            }
           ]
          }
         }
        }
       }
      }
     }
    }
   },
   "x-readme": {
    "headers": [],
    "explorer-enabled": true,
    "proxy-enabled": true
   },
   "x-readme-fauxas": true
  }
