 {
  "page": "https://dev.iugu.com/reference/listar-transferencias.md",
  "definition": {
   "openapi": "3.1.0",
   "info": {
    "title": "transferência-de-valores",
    "version": "1.0"
   },
   "servers": [
    {
     "url": "https://api.iugu.com/v1"
    }
   ],
   "components": {
    "securitySchemes": {
     "sec0": {
      "type": "apiKey",
      "in": "query",
      "name": "api_token"
     }
    }
   },
   "security": [
    {
     "sec0": []
    }
   ],
   "paths": {
    "/transfers": {
     "get": {
      "summary": "Listar Transferências",
      "description": "Retorna uma lista com as transferências efetuadas pela conta. Por padrão, retorna no máximo 100 registros.",
      "operationId": "listar-transferencias",
      "parameters": [
       {
        "name": "custom_variables_name",
        "in": "query",
        "description": "Filtra as transferências bancárias pelo nome da variável customizada",
        "schema": {
         "type": "string"
        }
       },
       {
        "name": "custom_variables_value",
        "in": "query",
        "description": "Filtra as transferências bancárias pelo valor da variável customizada",
        "schema": {
         "type": "string"
        }
       },
       {
        "name": "limit",
        "in": "query",
        "description": "Limita em até 100 o número de registros listados, usado para paginação.",
        "schema": {
         "type": "integer",
         "format": "int32",
         "default": 100
        }
       },
       {
        "name": "start",
        "in": "query",
        "description": "Usado para paginação. Define o número de registros que serão \"pulados\" na busca pelas transferências.",
        "schema": {
         "type": "integer",
         "format": "int32",
         "default": 0
        }
       },
       {
        "name": "created_at_from",
        "in": "query",
        "description": "Data e hora a partir das quais os saques foram atualizados (updated_at). Por padrão: 1 dia atrás. Formato: 2018-05-01T14:30:00-03:00.",
        "schema": {
         "type": "string",
         "format": "date"
        }
       },
       {
        "name": "created_at_to",
        "in": "query",
        "description": "Data e hora até as quais os saques foram atualizadas (updated_at). Por padrão: data e hora presentes. Formato: 2018-05-01T14:30:00-03:00.",
        "schema": {
         "type": "string",
         "format": "date"
        }
       },
       {
        "name": "transfer_type",
        "in": "query",
        "description": "Tipo de transaferência. Utilizado somente para \"Transferências\". Por padrão, todos os tipos de transferências considerados: account_requested, internal_transfer, mirror ou debit_transfer.",
        "schema": {
         "type": "string"
        }
       }
      ],
      "responses": {
       "200": {
        "description": "200",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{\n    \"sent\": [\n    {\n      \"id\": \"1234565F6F06412345ED425581234567\",\n      \"created_at\": \"2013-11-19T11:24:29-02:00\",\n      \"amount_cents\": \"1000\",\n      \"amount_localized\": \"R$ 10,00\",\n      \"receiver\": {\n        \"id\": \"77C2565F6F064A26ABED4255894224F0\",\n        \"name\": \"Nome da Conta\"\n      }\n    }\n  ],\n  \"received\": [\n    {\n      \"id\": \"1234565F6F06132345ED425581234567\",\n      \"created_at\": \"2013-12-19T11:24:29-02:00\",\n      \"amount_cents\": \"2000\",\n      \"amount_localized\": \"R$ 20,00\",\n      \"sender\": {\n        \"id\": \"77C2565F6F0611111BED4255894224F0\",\n        \"name\": \"Conta Teste\"\n      }\n    }\n  ]\n}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {
            "sent": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {
               "id": {
                "type": "string",
                "example": "1234565F6F06412345ED425581234567"
               },
               "created_at": {
                "type": "string",
                "example": "2013-11-19T11:24:29-02:00"
               },
               "amount_cents": {
                "type": "string",
                "example": "1000"
               },
               "amount_localized": {
                "type": "string",
                "example": "R$ 10,00"
               },
               "receiver": {
                "type": "object",
                "properties": {
                 "id": {
                  "type": "string",
                  "example": "77C2565F6F064A26ABED4255894224F0"
                 },
                 "name": {
                  "type": "string",
                  "example": "Nome da Conta"
                 }
                }
               }
              }
             }
            },
            "received": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {
               "id": {
                "type": "string",
                "example": "1234565F6F06132345ED425581234567"
               },
               "created_at": {
                "type": "string",
                "example": "2013-12-19T11:24:29-02:00"
               },
               "amount_cents": {
                "type": "string",
                "example": "2000"
               },
               "amount_localized": {
                "type": "string",
                "example": "R$ 20,00"
               },
               "sender": {
                "type": "object",
                "properties": {
                 "id": {
                  "type": "string",
                  "example": "77C2565F6F0611111BED4255894224F0"
                 },
                 "name": {
                  "type": "string",
                  "example": "Conta Teste"
                 }
                }
               }
              }
             }
            }
           }
          }
         }
        }
       },
       "400": {
        "description": "400",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {}
          }
         }
        }
       }
      },
      "deprecated": false
     }
    }
   },
   "x-readme": {
    "headers": [],
    "explorer-enabled": true,
    "proxy-enabled": true
   },
   "x-readme-fauxas": true
  }
