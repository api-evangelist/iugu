 {
  "page": "https://dev.iugu.com/reference/cancelar-pix-agendado.md",
  "definition": {
   "openapi": "3.1.0",
   "info": {
    "title": "transferência-de-valores",
    "version": "1.0"
   },
   "servers": [
    {
     "url": "https://api.iugu.com/v1"
    }
   ],
   "components": {
    "securitySchemes": {
     "sec0": {
      "type": "apiKey",
      "in": "query",
      "name": "api_token"
     }
    }
   },
   "security": [
    {
     "sec0": []
    }
   ],
   "paths": {
    "/transfer_requests/{id}/scheduled_cancel": {
     "patch": {
      "summary": "Cancelar Pix Agendado",
      "description": "Utilize o `live_api_token`<br><br>Cancela um PIX previamente agendado. **Importante:** O status da transferência deve ser `scheduled`.",
      "operationId": "cancelar-pix-agendado",
      "parameters": [
       {
        "name": "id",
        "in": "path",
        "description": "ID da Transferência. Informada no retorno do endpoint [Transferência para Terceiros](https://dev.iugu.com/reference/transfer%C3%AAncia-para-terceiros-1) — `/v1/transfer_requests` na propriedade `transfer_request_id`.",
        "schema": {
         "type": "string"
        },
        "required": true
       }
      ],
      "responses": {
       "200": {
        "description": "200",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{\n    \"transfer_request_id\": \"E2483B68CA624DC98A88AFC7D1565213\",\n    \"created_at\": \"2025-02-11T11:28:08-03:00\",\n    \"amount_cents\": 10,\n    \"transfer_type\": \"pix\",\n    \"end_to_end_id\": \"E151119752025021114280e7d38e1745\",\n    \"external_reference\": null,\n    \"receipt_url\": \"https://comprovantes.iugu.test/e2483b68-ca62-4dc9-8a88-afc7d1565213-d52c04\",\n    \"status\": \"cancelled\"\n}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {
            "transfer_request_id": {
             "type": "string",
             "example": "E2483B68CA624DC98A88AFC7D1565213"
            },
            "created_at": {
             "type": "string",
             "example": "2025-02-11T11:28:08-03:00"
            },
            "amount_cents": {
             "type": "integer",
             "example": 10,
             "default": 0
            },
            "transfer_type": {
             "type": "string",
             "example": "pix"
            },
            "end_to_end_id": {
             "type": "string",
             "example": "E151119752025021114280e7d38e1745"
            },
            "external_reference": {},
            "receipt_url": {
             "type": "string",
             "example": "https://comprovantes.iugu.test/e2483b68-ca62-4dc9-8a88-afc7d1565213-d52c04"
            },
            "status": {
             "type": "string",
             "example": "cancelled"
            }
           }
          }
         }
        }
       },
       "400": {
        "description": "400",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{\n    \"errors\": \"Transfer status must be scheduled.\"\n}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {
            "errors": {
             "type": "string",
             "example": "Transfer status must be scheduled."
            }
           }
          }
         }
        }
       }
      }
     }
    }
   },
   "x-readme": {
    "headers": [],
    "explorer-enabled": true,
    "proxy-enabled": true
   },
   "x-readme-fauxas": true
  }
