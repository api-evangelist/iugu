    "version": "1.0"
   },
   "servers": [
    {
     "url": "https://api.iugu.com/v1/payment_requests"
    }
   ],
   "components": {
    "securitySchemes": {
     "sec0": {
      "type": "apiKey",
      "in": "query",
      "name": "api_token"
     }
    }
   },
   "security": [
    {
     "sec0": []
    }
   ],
   "paths": {
    "/": {
     "post": {
      "summary": "Criar Pedido de Pagamento",
      "description": "Cria um pedido de pagamento.",
      "operationId": "criar-pedido-de-pagamento",
      "parameters": [
       {
        "name": "Request-Time",
        "in": "header",
        "description": "Timestamp do momento que enviar a requisição de assinatura digital (RSA)",
        "required": true,
        "schema": {
         "type": "string",
         "format": "date-time"
        }
       },
       {
        "name": "Signature",
        "in": "header",
        "description": "Assinatura digital validada",
        "required": true,
        "schema": {
         "type": "string",
         "default": "signature="
        }
       },
       {
        "in": "header",
        "name": "X-Signature-Token-Id",
        "schema": {
         "type": "string"
        },
        "description": "Indica explicitamente qual token/chave deve ser utilizado na assinatura da requisição, informando o ID do token desejado. Se omitido, mantém o comportamento atual."
       }
      ],
      "requestBody": {
       "content": {
        "application/json": {
         "schema": {
          "type": "object",
          "required": [
           "barcode",
           "amount_cents",
           "document_amount_cents"
          ],
          "properties": {
           "barcode": {
            "type": "string",
            "description": "Código de barras do pagamento"
           },
           "amount_cents": {
            "type": "integer",
            "description": "Valor de pagamento do boleto",
            "format": "int32"
           },
           "document_amount_cents": {
            "type": "integer",
            "description": "Valor total do boleto",
            "format": "int32"
           },
           "description": {
            "type": "string",
            "description": "Descrição do pagamento"
           }
          }
         }
        }
       }
      },
      "responses": {
       "200": {
        "description": "200",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{\n  \"id\": \"A1F7D3920C5B4E68A4729D1FE83BC047\",\n  \"account_id\": \"6B2E91CD7F0A4835B19C6D2E4A70F3D8\",\n  \"barcode\": \"23700000000000000000000000000000000000000000000\",\n  \"status\": \"pending\",\n  \"document_amount_cents\": 500,\n  \"amount_cents\": 500,\n  \"description\": null,\n  \"created_at\": \"2026-06-24T12:32:21-03:00\",\n  \"updated_at\": \"2026-06-24T12:32:21-03:00\",\n  \"receipt_url\": \"https://comprovantes.iugu.com/a1f7d392-0c5b-4e68-a472-9d1fe83bc047-f20fae\",\n  \"payment_info\": {\n    \"barcode\": \"23700000000000000000000000000000000000000000000\",\n    \"amount_cents\": 500,\n    \"fine_cents\": 0,\n    \"interest_cents\": 0,\n    \"discount_cents\": 0,\n    \"total_amount_cents\": 500,\n    \"recipient_name\": \"BANCO TESTE S.A.\",\n    \"recipient_cnpj_cpf\": \"67970552000101\",\n    \"payer_name\": \"João Teste da Silva\",\n    \"payer_cnpj_cpf\": \"50215552008\",\n    \"allow_amount_change\": false,\n    \"allow_partial_payment\": false,\n    \"due_date\": \"2026-06-25\",\n    \"maximum_payment_date\": \"2026-08-09T00:00:00.000Z\",\n    \"details\": null,\n    \"emitter\": \"BRADESCO S.A\",\n    \"payee_cnpj_cpf\": \"91326007000153\"\n  }"
           }
          },
          "schema": {
           "type": "object",
           "properties": {
            "id": {
             "type": "string",
             "example": "00000000000000000000000000000000"
            },
            "account_id": {
             "type": "string",
             "example": "00000000000000000000000000000000"
            },
            "barcode": {
             "type": "string",
             "example": "846100000013310502962023004200030007003752691117"
            },
            "status": {
             "type": "string",
             "example": "pending"
            },
            "document_amount_cents": {
             "type": "integer",
             "example": 10,
             "default": 0
            },
            "amount_cents": {
             "type": "integer",
             "example": 10,
             "default": 0
            },
            "description": {
             "type": "string",
             "example": "teste"
            },
            "created_at": {
             "type": "string",
             "example": "2024-08-15T17:54:56-03:00"
            },
            "updated_at": {
             "type": "string",
             "example": "2024-08-16T16:55:07-03:00"
            }
           }
          }
         }
        }
       }
      }
     }
    }
   },
