  "definition": {
   "openapi": "3.1.0",
   "info": {
    "title": "listar-pagamentos",
    "version": "1.0"
   },
   "servers": [
    {
     "url": "https://api.iugu.com/v1/payment_requests"
    }
   ],
   "components": {
    "securitySchemes": {
     "sec0": {
      "type": "apiKey",
      "in": "query",
      "name": "api_token"
     }
    }
   },
   "security": [
    {
     "sec0": []
    }
   ],
   "paths": {
    "/": {
     "get": {
      "summary": "Listar Pagamentos",
      "description": "Lista pagamentos de boleto de uma conta",
      "operationId": "listar-pagamentos",
      "parameters": [
       {
        "name": "start",
        "in": "query",
        "description": "Quantos registros pular do início da pesquisa, usado para paginação.",
        "schema": {
         "type": "integer",
         "format": "int32"
        }
       },
       {
        "name": "limit",
        "in": "query",
        "description": "Limita o número de registros retornados em até 100, que é o padrão de retorno desta chamada. Também utilizado em paginação.",
        "schema": {
         "type": "integer",
         "format": "int32"
        }
       },
       {
        "name": "created_at_from",
        "in": "query",
        "description": "Registros criados a partir dessa data passada no parâmetro. Formato (AAAA-MM-DD)",
        "schema": {
         "type": "string",
         "format": "date"
        }
       },
       {
        "name": "created_at_to",
        "in": "query",
        "description": "Registros criados até esta data passada no parâmetro. Formato (AAAA-MM-DD)",
        "schema": {
         "type": "string",
         "format": "date"
        }
       },
       {
        "name": "status",
        "in": "query",
        "description": "Usado para filtrar os pagamentos pelo status (pending, processing, rejected, done)",
        "schema": {
         "type": "string"
        }
       },
       {
        "name": "barcode",
        "in": "query",
        "description": "Código de barras do pagamento",
        "schema": {
         "type": "string"
        }
       },
       {
        "name": "updated_at_from",
        "in": "query",
        "description": "Registros atualizados a partir dessa data passada no parâmetro. Formato (AAAA-MM-DD)",
        "schema": {
         "type": "string",
         "format": "date"
        }
       },
       {
        "name": "updated_at_to",
        "in": "query",
        "description": "Registros atualizados a até esta data passada no parâmetro. Formato (AAAA-MM-DD)",
        "schema": {
         "type": "string",
         "format": "date"
        }
       }
      ],
      "responses": {
       "200": {
        "description": "200",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "[\n    {\n        \"id\": \"00000000000000000000000000000000\",\n        \"account_id\": \"00000000000000000000000000000000\",\n        \"barcode\": \"846100000013310502962023004200030007003752691117\",\n        \"status\": \"pending\",\n        \"document_amount_cents\": 13105,\n        \"amount_cents\": 13105,\n        \"description\": null,\n        \"created_at\": \"2024-08-16T17:09:59-03:00\",\n        \"updated_at\": \"2024-08-16T17:10:09-03:00\"\n    },\n    {\n        \"id\": \"00000000000000000000000000000000\",\n        \"account_id\": \"00000000000000000000000000000000\",\n        \"barcode\": \"846100000013310502962023004200030007003752691117\",\n        \"status\": \"pending\",\n        \"document_amount_cents\": 13105,\n        \"amount_cents\": 13105,\n        \"description\": null,\n        \"created_at\": \"2024-08-16T17:13:17-03:00\",\n        \"updated_at\": \"2024-08-16T17:13:28-03:00\"\n    }\n]"
           }
          },
          "schema": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "id": {
              "type": "string",
              "example": "00000000000000000000000000000000"
             },
             "account_id": {
              "type": "string",
              "example": "00000000000000000000000000000000"
             },
             "barcode": {
              "type": "string",
              "example": "846100000013310502962023004200030007003752691117"
             },
             "status": {
              "type": "string",
              "example": "pending"
             },
             "document_amount_cents": {
              "type": "integer",
              "example": 13105,
              "default": 0
             },
             "amount_cents": {
              "type": "integer",
              "example": 13105,
              "default": 0
             },
             "description": {},
             "created_at": {
              "type": "string",
              "example": "2024-08-16T17:09:59-03:00"
             },
             "updated_at": {
              "type": "string",
              "example": "2024-08-16T17:10:09-03:00"
             }
            }
           }
          }
         }
        }
       },
       "404": {
        "description": "404",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{\n    \"errors\": \"Not Found\"\n}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {
            "errors": {
             "type": "string",
             "example": "Not Found"
            }
           }
          }
         }
        }
       }
      },
      "deprecated": false
     }
    }
   },
   "x-readme": {
    "headers": [],
    "explorer-enabled": true,
    "proxy-enabled": true
   },
   "x-readme-fauxas": true
  }
