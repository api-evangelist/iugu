     "sec0": []
    }
   ],
   "paths": {
    "/profile/renew_access_token": {
     "post": {
      "summary": "Renovar API Token de Usuário",
      "description": "Gera um novo user_token de uma conta, nessa endpoint é obrigatório o uso do user_token da subconta.",
      "operationId": "renovar-api-token-de-usuario",
      "responses": {
       "200": {
        "description": "200",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{\n  \"new_user_token\": \"1234567890ABCDEF1234567890ABCDEF1234567890ABCDEF\"\n}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {
            "new_user_token": {
             "type": "string",
             "example": "1234567890ABCDEF1234567890ABCDEF1234567890ABCDEF"
            }
           }
          }
         }
        }
       },
       "400": {
        "description": "400",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{\n  \"errors\": \"Unauthorized\"\n}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {
            "errors": {
             "type": "string",
             "example": "Unauthorized"
            }
           }
          }
         }
        }
       }
      },
      "deprecated": false
     }
    }
   },
   "x-readme": {
    "headers": [],
    "explorer-enabled": true,
    "proxy-enabled": true
   },
   "x-readme-fauxas": true
  }
