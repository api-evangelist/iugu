     "delete": {
      "summary": "Remover API Token",
      "description": "Remove um \"api_token\" em uma subconta.<div class=\"magic-block-callout type-warning\"><h3><i title=\"Warning\" class=\"fa fa-exclamation-circle\"></i>Atenção</h3><div class=\"callout-body\"><p>Essa API obriga a utilização do \"Master_token\" na autenticação da chamada.</p></div></div>",
      "operationId": "remover-token-de-api",
      "parameters": [
       {
        "name": "account_id",
        "in": "path",
        "description": "ID da conta em que o token será removido",
        "schema": {
         "type": "string"
        },
        "required": true
       },
       {
        "name": "id",
        "in": "path",
        "description": "ID do Token",
        "schema": {
         "type": "string"
        },
        "required": true
