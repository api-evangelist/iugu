        "in": "header",
        "description": "Timestamp do momento que enviar a requisição de assinatura digital (RSA)",
        "required": true,
        "schema": {
         "type": "string"
        }
       },
       {
        "name": "Signature",
        "in": "header",
        "description": "Assinatura digital",
        "required": true,
        "schema": {
         "type": "string",
         "default": "singature="
        }
       }
      ],
      "responses": {
       "200": {
        "description": "200",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{\n  \"id\": \"1234567890ABCDEF\",\n  \"token\": \"ABCDEF1234567890ABCDEF1234567890ABCDEF1234567890\",\n  \"api_type\": \"LIVE\",\n  \"description\": \"Descrição\",\n  \"created_at\": \"2025-04-02T13:09:08-03:00\",\n  \"status\": \"active\"\n}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {
            "id": {
             "type": "string",
             "example": "1234567890ABCDEF"
            },
            "token": {
             "type": "string",
             "example": "ABCDEF1234567890ABCDEF1234567890ABCDEF1234567890"
            },
            "api_type": {
             "type": "string",
             "example": "LIVE"
            },
            "description": {
             "type": "string",
             "example": "Descrição"
            },
            "created_at": {
             "type": "string",
             "example": "2025-04-02T13:09:08-03:00"
            },
            "status": {
             "type": "string",
             "example": "active"
            }
           }
          }
         }
        }
       },
       "400": {
        "description": "400",
        "content": {
         "application/json": {
          "examples": {
           "Result": {
            "value": "{\n  \"errors\": \"Api token Not Found\"\n}"
           }
          },
          "schema": {
           "type": "object",
           "properties": {
            "errors": {
             "type": "string",
             "example": "Api token Not Found"
            }
           }
          }
         }
        }
       }
      }
     }
    }
   },
